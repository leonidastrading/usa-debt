# Optional. Without it the app reads FRED's public CSV endpoint (no key needed).
# Free key: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# Optional. Enables the AI news digest on the News page.
ANTHROPIC_API_KEY=

# Optional. Protects /api/refresh; Vercel Cron sends it automatically as a Bearer token.
CRON_SECRET=
